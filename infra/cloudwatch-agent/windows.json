{
  "agent": {
    "metrics_collection_interval": 300
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "Memory": {
        "measurement": [
          { "name": "% Committed Bytes In Use", "unit": "Percent" }
        ]
      },
      "LogicalDisk": {
        "resources": ["C:", "D:", "E:"],
        "measurement": [
          { "name": "% Free Space", "unit": "Percent" }
        ]
      }
    }
  }
}
