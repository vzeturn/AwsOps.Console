{
  "name": "ops-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless AWS operations dashboard: infrastructure, compliance & backup, cost, with Entra ID SSO",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace shared && npm run build --workspace backend && npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "deploy": "npm run build && bash infra/deploy.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.12.0",
    "typescript-eslint": "8.70.0"
  }
}
